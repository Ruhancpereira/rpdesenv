# Coloca um ficheiro .env na raiz do repositório ou em chamados-api/ (ou qualquer pasta acima do cwd).
# O Spring regista-o antes de resolver o application.yml; variáveis já definidas no SO/IDE têm prioridade.

# --- Claude (Anthropic) — assistente do Agrosys ---
# Chave: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Opcional: modelo (predefinido: claude-sonnet-4-6). Para custo menor, considera claude-haiku-4-5-20251001.
# ANTHROPIC_MODEL=claude-sonnet-4-6
# Limite de tokens por resposta (predefinido 2048). Aumenta só se cortar respostas úteis.
# ANTHROPIC_MAX_OUTPUT_TOKENS=2048
# 0.0–1.0; mais baixo = respostas mais focadas (predefinido 0.3).
# ANTHROPIC_TEMPERATURE=0.3
# Máximo de voltas modelo↔ferramentas por pergunta (predefinido 8).
# ANTHROPIC_MAX_TOOL_ROUNDS=8

# Provedor: anthropic (predefinido), auto, openai, gemini
# Não deixes ASSISTANT_PROVIDER vazio no .env — string vazia passa a ser tratada como anthropic no código.
# ASSISTANT_PROVIDER=anthropic

# Lista & filtros: máximo de linhas quando listarTodos=true (UI ou ?listarTodos=true na API).
# CHAMADOS_LISTA_MAX_TUDO=100000
# Ferramenta chamados_amostra no assistente (máx. linhas JSON por chamada).
# CHAMADOS_ASSISTENTE_MAX=20000

# --- Outros motores (só se ASSISTANT_PROVIDER=auto ou forçares outro provedor) ---
# OPENAI_API_KEY=
# GEMINI_API_KEY=
