generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  COORDENADOR
  GERENTE
  CONSULTOR
  CS
  DIRETORIA
}

enum RiskLevel {
  BAIXO
  MEDIO
  ALTO
  CRITICO
}

enum Priority {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum ProjectStatus {
  PLANEJADO
  EM_ANDAMENTO
  ATRASADO
  BLOQUEADO
  CONCLUIDO
}

enum PhaseStatus {
  NAO_INICIADA
  EM_ANDAMENTO
  BLOQUEADA
  CONCLUIDA
}

enum AllocationLocation {
  REMOTO
  PRESENCIAL
}

enum AgendaStatus {
  PLANEJADA
  CONFIRMADA
  EXECUTADA
  CANCELADA
}

enum ActivityType {
  IMPLANTACAO_PRODUTIVA
  REUNIAO_CLIENTE
  REUNIAO_INTERNA
  DESLOCAMENTO
  TREINAMENTO
  FOLLOW_UP
  SUPORTE_PROJETO
  RETRABALHO
  CONTINGENCIA
}

enum NpsClassification {
  PROMOTOR
  NEUTRO
  DETRATOR
}

enum TreatmentStatus {
  ABERTO
  EM_TRATAMENTO
  CONCLUIDO
}

enum TaskStatus {
  ABERTA
  EM_ANDAMENTO
  BLOQUEADA
  CONCLUIDA
}

enum TaskOrigin {
  PROJETO
  CLIENTE
  NPS
  RISCO
  HEALTH_SCORE
  PENDENCIA
  AUTOMACAO
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs AuditLog[]
}

model Collaborator {
  id                String   @id @default(cuid())
  name              String
  roleTitle         String
  status            Boolean  @default(true)
  dailyHours        Float
  weeklyHours       Float
  nominalCapacity   Float
  usefulCapacity    Float
  email             String   @unique
  phone             String?
  managerName       String?
  notes             String?
  cityRegion        String
  canTravel         Boolean  @default(false)
  remoteEnabled     Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  skills               CollaboratorSkill[]
  managedProjects      Project[]            @relation("ProjectManager")
  csProjects           Project[]            @relation("ProjectCS")
  consultantProjects   ProjectConsultant[]
  allocations          Allocation[]
  assignedPhases       ProjectPhase[]
  healthScoresAsOwner  HealthScore[]
  assignedTasks        Task[]
  npsTreatments        NpsEntry[]           @relation("NpsTreatmentOwner")
  auditReferences      AuditLog[]           @relation("AuditCollaboratorRef")
}

model Core {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  criticality RiskLevel @default(MEDIO)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules     BusinessModule[]
  skills      CollaboratorSkill[]
  allocations Allocation[]
}

model BusinessModule {
  id                   String   @id @default(cuid())
  name                 String
  criticality          RiskLevel @default(MEDIO)
  minimumCapacitated   Int       @default(1)
  coreId               String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  core        Core                @relation(fields: [coreId], references: [id], onDelete: Cascade)
  submodules  Submodule[]
  skills      CollaboratorSkill[]
  allocations Allocation[]
  alerts      AutomationAlert[]

  @@unique([name, coreId])
}

model Submodule {
  id         String   @id @default(cuid())
  name       String
  criticality RiskLevel @default(MEDIO)
  moduleId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  module BusinessModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([name, moduleId])
}

model CollaboratorSkill {
  id             String   @id @default(cuid())
  collaboratorId String
  coreId         String
  moduleId       String
  level          Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  collaborator Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  core         Core         @relation(fields: [coreId], references: [id], onDelete: Cascade)
  module       BusinessModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([collaboratorId, moduleId])
}

model Client {
  id                   String   @id @default(cuid())
  corporateName        String
  tradeName            String
  segment              String
  companySize          String
  city                 String
  state                String
  mainContact          String
  executiveSponsor     String?
  implementationStatus ProjectStatus @default(PLANEJADO)
  currentRisk          RiskLevel     @default(MEDIO)
  startDate            DateTime
  goLiveForecast       DateTime
  notes                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  projects      Project[]
  allocations   Allocation[]
  healthScores  HealthScore[]
  npsEntries    NpsEntry[]
  tasks         Task[]
}

model Project {
  id                String       @id @default(cuid())
  name              String
  clientId          String
  managerId         String
  csOwnerId         String
  status            ProjectStatus @default(PLANEJADO)
  currentPhase      String
  priority          Priority      @default(MEDIA)
  criticality       RiskLevel     @default(MEDIO)
  startDate         DateTime
  targetEndDate     DateTime
  progressPercent   Int           @default(0)
  projectRisk       RiskLevel     @default(MEDIO)
  clientPending     String?
  internalPending   String?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  client           Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  manager          Collaborator         @relation("ProjectManager", fields: [managerId], references: [id], onDelete: Restrict)
  csOwner          Collaborator         @relation("ProjectCS", fields: [csOwnerId], references: [id], onDelete: Restrict)
  consultants      ProjectConsultant[]
  phases           ProjectPhase[]
  allocations      Allocation[]
  healthScores     HealthScore[]
  npsEntries       NpsEntry[]
  tasks            Task[]
  alerts           AutomationAlert[]
}

model ProjectConsultant {
  projectId      String
  collaboratorId String
  createdAt      DateTime @default(now())

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  collaborator Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)

  @@id([projectId, collaboratorId])
}

model ProjectPhase {
  id                String      @id @default(cuid())
  projectId         String
  name              String
  checklist         String?
  responsibleId     String
  plannedDate       DateTime
  actualDate        DateTime?
  status            PhaseStatus @default(NAO_INICIADA)
  impediments       String?
  entryCriteria     String?
  exitCriteria      String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  responsible  Collaborator @relation(fields: [responsibleId], references: [id], onDelete: Restrict)

  @@unique([projectId, name])
}

model Allocation {
  id             String             @id @default(cuid())
  collaboratorId String
  clientId       String
  projectId      String
  coreId         String
  moduleId       String
  activityType   ActivityType
  date           DateTime
  startTime      String
  endTime        String
  allocatedHours Float
  location       AllocationLocation
  city           String
  requester      String
  priority       Priority           @default(MEDIA)
  agendaStatus   AgendaStatus       @default(PLANEJADA)
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  collaborator Collaborator   @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  client       Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  core         Core           @relation(fields: [coreId], references: [id], onDelete: Restrict)
  module       BusinessModule @relation(fields: [moduleId], references: [id], onDelete: Restrict)
}

model HealthScore {
  id                  String    @id @default(cuid())
  clientId            String
  projectId           String
  csOwnerId           String
  score               Float
  status              RiskLevel
  escalationRisk      Boolean   @default(false)
  engagement          Int       @default(0)
  scheduleAdherence   Int       @default(0)
  meetingPresence     Int       @default(0)
  openPendencies      Int       @default(0)
  progressPerception  Int       @default(0)
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  client   Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project  Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  csOwner  Collaborator @relation(fields: [csOwnerId], references: [id], onDelete: Restrict)
  tasks    Task[]
}

model NpsEntry {
  id               String            @id @default(cuid())
  clientId         String
  projectId        String
  phase            String
  date             DateTime
  score            Int
  comment          String?
  mainReason       String
  reasonCategory   String
  treatmentOwnerId String?
  actionPlan       String?
  treatmentStatus  TreatmentStatus   @default(ABERTO)
  classification   NpsClassification
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  treatmentOwner Collaborator? @relation("NpsTreatmentOwner", fields: [treatmentOwnerId], references: [id], onDelete: SetNull)
  tasks          Task[]
}

model Task {
  id             String     @id @default(cuid())
  title          String
  description    String?
  responsibleId  String
  dueDate        DateTime
  priority       Priority   @default(MEDIA)
  status         TaskStatus @default(ABERTA)
  origin         TaskOrigin
  clientId       String?
  projectId      String?
  npsId          String?
  healthScoreId  String?
  comments       String?
  attachmentUrl  String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  responsible Collaborator @relation(fields: [responsibleId], references: [id], onDelete: Restrict)
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  nps         NpsEntry?    @relation(fields: [npsId], references: [id], onDelete: SetNull)
  healthScore HealthScore? @relation(fields: [healthScoreId], references: [id], onDelete: SetNull)
}

model AutomationAlert {
  id          String    @id @default(cuid())
  type        String
  severity    RiskLevel
  message     String
  resolved    Boolean   @default(false)
  projectId   String?
  moduleId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  module  BusinessModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id             String   @id @default(cuid())
  entityType     String
  entityId       String
  action         String
  details        String?
  userId         String?
  collaboratorId String?
  createdAt      DateTime @default(now())

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  collaborator Collaborator? @relation("AuditCollaboratorRef", fields: [collaboratorId], references: [id], onDelete: SetNull)
}
